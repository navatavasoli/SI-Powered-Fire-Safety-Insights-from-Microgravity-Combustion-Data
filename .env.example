# Copy to .env (never commit .env — it's in .gitignore).
# Set ONE of these. Gemini key: https://aistudio.google.com/apikey · Groq key: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: choose when both are set (gemini|groq); pin a model instead of auto-picking.
LLM_PROVIDER=
GEMINI_MODEL=
GROQ_MODEL=
# Optional: frontend origin(s) allowed to call the API.
CORS_ORIGINS=http://localhost:3000
